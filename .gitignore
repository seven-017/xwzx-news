# ============================================================
#  xwzx-news 根目录 .gitignore
#  规则：凡是「能重新生成的」和「含密钥的」，一律不提交
# ============================================================

# ---------- 环境变量与密钥（绝对不能提交） ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Python / 后端 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 测试与缓存 ----------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
