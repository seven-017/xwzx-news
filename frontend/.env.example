# 前端环境变量模板
# 用法：把本文件复制一份改名为 .env，再填入你自己的真实值
# .env 不会提交到 Git，本文件（.env.example）会提交

# 后端 API 地址
VITE_API_BASE_URL=http://127.0.0.1:8000

# AI 问答（阿里云百炼 DashScope，OpenAI 兼容模式）
# API Key 到 https://bailian.console.aliyun.com/ 申请
VITE_AI_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_AI_API_KEY=sk-在这里填你自己的密钥
VITE_AI_MODEL=qwen3-max-preview
